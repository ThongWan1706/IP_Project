  characterNameText: {fileID: 1732517299}
  conversationText: {fileID: 1521663922}
  residentName: Resident
  policeName: Police Officer
  residentNameColour: {r: 1, g: 1, b: 1, a: 1}
  policeNameColour: {r: 1, g: 1, b: 1, a: 1}
  openingDialogue:
  - speaker: 1
    sentence: Hey! You do know that Jaywalker is dangerous right?
  - speaker: 0
    sentence: Sorry officer! But the traffic light for the pedestrian crossing I
      always have to wait for so long even though it's a short distance
  option1Response:
  - speaker: 1
    sentence: In the end your safety still matters, next time please use the pedestrain
      crossing.
  - speaker: 0
    sentence: Okay then Sir.
  option2Response:
  - speaker: 1
    sentence: Simce jaywalker is a crime, I'll have to fine you $100.
  - speaker: 0
    sentence: Sir! It's just a one time thing! Fining me for this are you being too
      serious?!
  - speaker: 1
    sentence: This is still against the law, here's your fine.
  - speaker: 0
    sentence: Piss off!
  playerHUD: {fileID: 1477231629}
  playerControlScripts:
  - {fileID: 121833268}
